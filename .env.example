# Supabase → Project Settings → Data API / API Keys
# Copy this file to `.env` and fill in both values.
#
# Anything prefixed VITE_ is bundled into the public JavaScript. Only ever put
# the *anon* (publishable) key here — never the service_role / secret key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
